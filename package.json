{
  "name": "legend-doctor",
  "version": "0.0.0",
  "description": "Read-only React analyzer that proves which useState and useEffect hooks waste renders, and the exact Legend State edit that cuts them.",
  "keywords": [
    "cli",
    "coding-agents",
    "legend-state",
    "linter",
    "performance",
    "re-renders",
    "react",
    "react-compiler",
    "react-hooks",
    "react-native",
    "skill",
    "static-analysis",
    "typescript",
    "useeffect",
    "usestate"
  ],
  "homepage": "https://github.com/Genie-sa/legend-doctor#readme",
  "bugs": {
    "url": "https://github.com/Genie-sa/legend-doctor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genie-sa/legend-doctor.git"
  },
  "bin": {
    "legend-doctor": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "skills",
    "EXAMPLES.md"
  ],
  "type": "module",
  "exports": {
    "./runtime": "./dist/src/runtime/dom.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "npm run build && node dist/evals/benchmark.js",
    "build": "node -e \"fs.rmSync('dist', { force: true, recursive: true })\" && tsc -p tsconfig.json",
    "changeset": "changeset",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm test && npm run pack:check",
    "eval": "npm run build && node dist/evals/run.js",
    "eval:runtime": "npm run build && node --test \"dist/tests/runtime/*.test.js\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "release": "npm run build && changeset publish",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@legendapp/state": "3.0.0-beta.48",
    "@oxlint/plugins": "1.81.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jsdom": "26.1.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "pkg-pr-new": "^0.0.75",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "peerDependencies": {
    "jsdom": ">=26",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
