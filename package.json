{
  "name": "legend-doctor",
  "version": "0.0.1",
  "private": true,
  "description": "Agent-first React hook triage for Legend State",
  "bin": {
    "legend-doctor": "./dist/src/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "eval": "npm run build && node dist/evals/run.js",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.80.0",
    "@types/node": "^22.0.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "engines": {
    "node": ">=22"
  }
}
